diff --git a/test/receipt-read.test.js b/test/receipt-read.test.js
new file mode 100644
--- /dev/null
+++ b/test/receipt-read.test.js
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {privateHub} from '../src/private.js';
+import {database} from './db.js';
+async function fixture(){
+ const db=database();
+ await db.prepare('INSERT INTO deliveries VALUES(?,?,?,?,?,?,?,?)').bind('exact-1','private-hash','brain::brain_save','{}','UNKNOWN','2026-10-26T00:00:00Z','2026-10-26T00:00:00Z',null).run();
+ return {db,bridge:privateHub({HUB_DB:db,MANAGED_CONNECTORS:JSON.stringify([{id:'brain'},{id:'factory'}])},()=>{throw Error('READ_MUST_NOT_FETCH');})};
+}
+test('exact managed connector lookup preserves uncertainty, redacts hash and never mutates',async()=>{
+ const {db,bridge}=await fixture();
+ const before=await db.prepare('SELECT * FROM deliveries').all();
+ const r=await bridge.receipt({connectorId:'brain',messageId:'exact-1'});
+ assert.equal(r.status,'FOUND');assert.equal(r.receipt.state,'UNKNOWN');assert.equal(r.receipt.taskSuccess,null);assert.equal(r.receipt.messageId,'exact-1');assert.equal('request_hash' in r.receipt,false);
+ assert.deepEqual(await db.prepare('SELECT * FROM deliveries').all(),before);
+ assert.deepEqual(await db.prepare('SELECT * FROM connectors').all(),{results:[]});
+});
+test('cross connector and absent rows are indistinguishable; unmanaged scope denied',async()=>{
+ const {bridge}=await fixture();
+ assert.deepEqual(await bridge.receipt({connectorId:'factory',messageId:'exact-1'}),{status:'NOT_FOUND',receipt:null});
+ assert.deepEqual(await bridge.receipt({connectorId:'brain',messageId:'missing'}),{status:'NOT_FOUND',receipt:null});
+ await assert.rejects(bridge.receipt({connectorId:'unknown',messageId:'exact-1'}),/CONNECTOR_NOT_MANAGED/);
+});
+test('malformed exact lookup fails before storage use',async()=>{
+ const {bridge}=await fixture();
+ for(const input of [{connectorId:'brain',messageId:123},{connectorId:123,messageId:'exact-1'},null,{}, {connectorId:'brain',messageId:'bad/id'}, {connectorId:'brain',messageId:'exact-1',actor:'owner'}])await assert.rejects(bridge.receipt(input),/INVALID_RECEIPT_QUERY/);
+});
