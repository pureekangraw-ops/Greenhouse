+// Explicit projection reads only. Source authorization remains at Greenhouse.
+const attempt={type:'string',minLength:1,maxLength:128,pattern:'^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$'};
+const schema=(properties,required=[])=>({type:'object',properties,required,additionalProperties:false});
+export const GREENHOUSE_READ_TOOLS=[
+ {name:'greenhouse_delivery_list',description:'Read recent scoped delivery projections; coverage is a recent window, not all Work.',inputSchema:schema({limit:{type:'integer',minimum:1,maximum:30}}),annotations:{readOnlyHint:true}},
+ {name:'greenhouse_delivery_get',description:'Read one scoped delivery attempt and redacted journal. Delivery status does not determine Work completion.',inputSchema:schema({attemptId:attempt},['attemptId']),annotations:{readOnlyHint:true}},
+ {name:'greenhouse_result_get',description:'Read result references and availability for one scoped attempt; unavailable proof remains unknown.',inputSchema:schema({attemptId:attempt},['attemptId']),annotations:{readOnlyHint:true}},
+];
+export const isGreenhouseRead=name=>GREENHOUSE_READ_TOOLS.some(t=>t.name===name);
+export function validateGreenhouseRead(name,a){
+ if(!a||typeof a!=='object'||Array.isArray(a))throw Error('INVALID_GREENHOUSE_READ');
+ const list=name==='greenhouse_delivery_list';
+ if(Object.keys(a).some(k=>k!==(list?'limit':'attemptId')))throw Error('INVALID_GREENHOUSE_READ');
+ if(list){if(a.limit!==undefined&&(!Number.isInteger(a.limit)||a.limit<1||a.limit>30))throw Error('INVALID_GREENHOUSE_READ');}
+ else if(typeof a.attemptId!=='string'||a.attemptId.length>128||!/^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/.test(a.attemptId))throw Error('INVALID_GREENHOUSE_READ');
+}
+export async function hubDeliveryReceipt(env,a){
+ if(!a||typeof a!=='object'||Array.isArray(a)||Object.keys(a).some(k=>!['connectorId','messageId'].includes(k))||typeof a.connectorId!=='string'||typeof a.messageId!=='string'||!/^[A-Za-z0-9_-]{1,100}$/.test(a.connectorId)||!/^[A-Za-z0-9_-]{1,100}$/.test(a.messageId))throw Error('INVALID_RECEIPT_QUERY');
+ if(typeof env.HUB_V2?.receipt!=='function')throw Error('HUB_RECEIPT_NOT_CONFIGURED');
+ return env.HUB_V2.receipt(a);
+}
